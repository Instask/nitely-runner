{
  "name": "@nitely/runner",
  "version": "0.1.0",
  "description": "Customer-hosted Nitely runner daemon for local assignment execution and runner/control-plane protocol rehearsal.",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "ai",
    "agent",
    "developer-tools",
    "runner",
    "control-plane",
    "automation"
  ],
  "homepage": "https://github.com/Instask/nitely-runner#readme",
  "bugs": {
    "url": "https://github.com/Instask/nitely-runner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Instask/nitely-runner.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nitely-runner": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./assignment-runner": {
      "types": "./dist/assignment-runner.d.ts",
      "default": "./dist/assignment-runner.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./file-control-plane": {
      "types": "./dist/file-control-plane.d.ts",
      "default": "./dist/file-control-plane.js"
    },
    "./heartbeat": {
      "types": "./dist/heartbeat.d.ts",
      "default": "./dist/heartbeat.js"
    },
    "./http-control-plane": {
      "types": "./dist/http-control-plane.d.ts",
      "default": "./dist/http-control-plane.js"
    },
    "./local-nitely-executor": {
      "types": "./dist/local-nitely-executor.d.ts",
      "default": "./dist/local-nitely-executor.js"
    },
    "./local-state": {
      "types": "./dist/local-state.d.ts",
      "default": "./dist/local-state.js"
    },
    "./memory-control-plane": {
      "types": "./dist/memory-control-plane.d.ts",
      "default": "./dist/memory-control-plane.js"
    },
    "./runner-config": {
      "types": "./dist/runner-config.d.ts",
      "default": "./dist/runner-config.js"
    }
  },
  "files": [
    "dist/assignment-runner.js",
    "dist/assignment-runner.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/file-control-plane.js",
    "dist/file-control-plane.d.ts",
    "dist/heartbeat.js",
    "dist/heartbeat.d.ts",
    "dist/http-control-plane.js",
    "dist/http-control-plane.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lifecycle.js",
    "dist/lifecycle.d.ts",
    "dist/local-nitely-executor.js",
    "dist/local-nitely-executor.d.ts",
    "dist/local-state.js",
    "dist/local-state.d.ts",
    "dist/memory-control-plane.js",
    "dist/memory-control-plane.d.ts",
    "dist/runner-config.js",
    "dist/runner-config.d.ts",
    "docs/",
    "examples/"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.7",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
